          maxWeeks = Math.max(1, Math.min(6, Math.floor(coveredDays / 7)));
        }
        var rollingMonth = cfg.initialView === 'rollingMonth' && cfg.views && cfg.views.rollingMonth;
        // Capped rows stretch to share the height, so every week count "fits" and counting
        // them proves nothing — a capped grid keeps the weeks the server asked for.
        var expandWeeksToFillHeight = rollingMonth && !cfg.dayMaxEventRows;
        if (expandWeeksToFillHeight) { cfg.views.rollingMonth.duration = { weeks: maxWeeks }; }

        var calendar = new FullCalendar.Calendar(node, Object.assign(baseOpts, cfg));
        calendar.render();

        var finish = function() {
          // A month name with no room beside its day number (the OG's half in portrait has
          // about 34 px a day) is left out rather than cut to "O…": the bold 1 still marks
          // where the month starts
          // (cut short, or pushed out of its cell's left edge next to a forecast)
          node.querySelectorAll('.mono-month').forEach(function(month) {
            var cell = month.closest('.mono-day-top');
            if (month.scrollWidth > month.clientWidth + 1 ||
                (cell && month.getBoundingClientRect().left < cell.getBoundingClientRect().left - 0.5)) {
              month.classList.add('mono-month--no-room');
            }
          });
          if (built.errors.length) {
            var err = document.createElement('div');
            err.className = 'trmnl-calendar-error text--small';
            err.textContent = 'Could not load ' + built.errors.join('; ');
            node.parentNode.insertBefore(err, node);
          }

          // Title bar: the visible date range, the same text FullCalendar's toolbar would show
          var titleRange = (node.closest('.view') || document).querySelector('.title_bar [data-calendar-range]');
          if (titleRange) titleRange.textContent = calendar.view.title;

          node.setAttribute('data-initialized', 'true');
        };

        // Count the week rows that landed fully on screen (row height is content-
        // driven, so dense months fit fewer). Re-render with just those weeks so
        // the range — and the title — match what is actually visible.
        // FullCalendar 7 lays out events once its ResizeObservers have measured the grid,
        // which is after render() returns: count once that has run, two frames later.
        // Rects include the framework's screen transform (1.8 on the TRMNL X); only their
        // order matters here, plus a tolerance of one CSS pixel.
        var fitWeeksToHeight = function() {
          var rect = node.getBoundingClientRect();
          var gridBottom = rect.bottom + (node.offsetHeight ? rect.height / node.offsetHeight : 1);
          var weekRows = node.querySelectorAll('.mono-week');
          var fitWeeks = 0;
          weekRows.forEach(function(tr){ if (tr.getBoundingClientRect().bottom <= gridBottom) fitWeeks++; });
          // Upstream keeps at least 4 weeks, so a busy month is cut off at the bottom.
          // "Busy weeks" setting: show only the weeks that fit, so every event stays
          // visible, or keep at least 3 and let each day end in "+N more".
          var capDays = settings.weekOverflow === 'more' && fitWeeks < 3;
          fitWeeks = Math.min(maxWeeks, Math.max(settings.weekOverflow === 'more' ? 3 : 1, fitWeeks));
          if (fitWeeks < weekRows.length) {
            calendar.destroy();
            cfg.views.rollingMonth.duration = { weeks: fitWeeks };
            if (capDays) cfg.dayMaxEvents = true;
            // a one-week grid has no day numbers (FullCalendar shows them from two weeks
            // on), so the header names the dates
            if (fitWeeks === 1) cfg.dayHeaderFormat = { weekday: 'short', day: 'numeric' };
            calendar = new FullCalendar.Calendar(node, Object.assign(baseOpts, cfg));
            calendar.render();
            // Fewer weeks share the height differently, so the last one can still overrun
            // (seen with the title bar and no screen padding): count again until they fit.
            // Each pass has fewer weeks, so this ends.
            afterLayout(fitWeeksToHeight);
            return;
          }
          afterLayout(finish);
        };
        var afterLayout = function(fn) {
          requestAnimationFrame(function() { requestAnimationFrame(function() {
            try { fn(); } catch (e) { console.error(e); node.setAttribute('data-initialized', 'true'); }
          }); });
        };
        afterLayout(expandWeeksToFillHeight ? fitWeeksToHeight : finish);
      });
    } catch (e) { console.error(e); }
  };

  // Auto-init on DOM ready
  document.addEventListener('DOMContentLoaded', function(){
    window.trmnlInitCalendars(document);
  });
</script>

{% comment %} The calendar markup, printed by each view (see full.liquid) {% endcomment %}
{% capture rolling_calendar %}
{% assign s = trmnl.plugin_settings.custom_fields_values %}
{% assign time_zone = s.time_zone | default: trmnl.user.time_zone_iana | default: "UTC" %}
{% assign locale = s.locale | default: "en" | strip %}
{% comment %} The on/off settings: boolean fields (true/false), but installs from before they were
   saved "yes"/"no" as text, which the form keeps until it is saved again. Read through json, so
   each engine gives the same text. On by default: off for false, "no" or "false" {% endcomment %}
{% assign v = s.highlight_today | json %}{% if v == 'false' or v == '"no"' or v == '"false"' %}{% assign on_highlight_today = false %}{% else %}{% assign on_highlight_today = true %}{% endif %}
{% assign v = s.shade_weekends | json %}{% if v == 'false' or v == '"no"' or v == '"false"' %}{% assign on_shade_weekends = false %}{% else %}{% assign on_shade_weekends = true %}{% endif %}
{% assign v = s.fade_past_events | json %}{% if v == 'false' or v == '"no"' or v == '"false"' %}{% assign on_fade_past_events = false %}{% else %}{% assign on_fade_past_events = true %}{% endif %}
{% assign v = s.include_past_events | json %}{% if v == 'false' or v == '"no"' or v == '"false"' %}{% assign on_include_past_events = false %}{% else %}{% assign on_include_past_events = true %}{% endif %}
{% assign v = s.include_event_time | json %}{% if v == 'false' or v == '"no"' or v == '"false"' %}{% assign on_include_event_time = false %}{% else %}{% assign on_include_event_time = true %}{% endif %}
{% assign v = s.display_event_end | json %}{% if v == 'false' or v == '"no"' or v == '"false"' %}{% assign on_display_event_end = false %}{% else %}{% assign on_display_event_end = true %}{% endif %}
{% comment %} Off by default: on for true, "yes" or "true" {% endcomment %}
{% assign v = s.show_week_numbers | json %}{% if v == 'true' or v == '"yes"' or v == '"true"' %}{% assign on_show_week_numbers = true %}{% else %}{% assign on_show_week_numbers = false %}{% endif %}
{% assign v = s.month_header | json %}{% if v == 'true' or v == '"yes"' or v == '"true"' %}{% assign on_month_header = true %}{% else %}{% assign on_month_header = false %}{% endif %}
{% comment %} ICS feeds replace the HA entities when set (see polling_url in settings.yml);
   on TRMNL.com the Plugin Merge dropdowns replace them both (below) {% endcomment %}
{% assign source = "ha" %}
{% if s.ics_urls contains "/" %}{% assign source = "ics" %}{% endif %}
{% comment %}
  LaraPaper passes the payload as `data`: one calendar's response, or {IDX_0: ..., IDX_1: ...}
  for several. TRMNL and trmnlp have no `data` for several URLs, only IDX_0, IDX_1, ... at the
  top level, so collect those (up to ten; unused ones come out as null, which the JS reads as empty calendars).
{% endcomment %}
{% assign events_json = data | json %}
{% if IDX_0 %}{% unless data %}{% capture events_json %}{
    "IDX_0": {{ IDX_0 | json }}, "IDX_1": {{ IDX_1 | json }}, "IDX_2": {{ IDX_2 | json }}, "IDX_3": {{ IDX_3 | json }}, "IDX_4": {{ IDX_4 | json }},
    "IDX_5": {{ IDX_5 | json }}, "IDX_6": {{ IDX_6 | json }}, "IDX_7": {{ IDX_7 | json }}, "IDX_8": {{ IDX_8 | json }}, "IDX_9": {{ IDX_9 | json }}
}{% endcapture %}{% endunless %}{% endif %}
{% comment %} TRMNL.com's Plugin Merge dropdowns, collected by plugin/trmnl-com-merge/merge.liquid {% endcomment %}
{% if merge_sources %}{% assign source = "merge" %}{% assign events_json = merge_json %}{% endif %}

<div class="layout layout--col layout--stretch">
  <div class="trmnl-calendar trmnl-calendar--month{% if on_highlight_today %} highlight-today{% endif %}{% if on_shade_weekends %} shade-weekends{% endif %}{% if on_fade_past_events %} fade-past{% endif %}"
       data-events="{{ events_json | escape }}"
       data-calendar-config='{
         "timeZoneName": {{ time_zone | json | escape }},
         "nowUtc": {{ trmnl.system.timestamp_utc | default: 0 }},
         "source": "{{ source }}",
         "calendarEntities": {% if source != "ha" %}""{% else %}{{ s.calendars | default: "" | json | escape }}{% endif %},
         "calendarPrefixes": {{ s.calendar_labels | default: "" | json | escape }},
         "calendarColors": {{ s.calendar_colors | default: "" | json | escape }},
         "weatherEntity": {% if source != "merge" and s.weather_entity contains "weather." %}{{ s.weather_entity | strip | json | escape }}{% else %}""{% endif %},
         "weatherPlugin": {% if merge_weather %}true{% else %}false{% endif %},
         "weatherLows": {% if s.weather_temperatures == "high_low" %}true{% else %}false{% endif %},
         "ignoredPhrases": {{ s.ignored_phrases | default: "" | json | escape }},
         "ignoredPhrasesExactMatch": {{ s.ignored_phrases_exact_match | default: "" | json | escape }},
         "includePastEvents": {% if on_include_past_events %}true{% else %}false{% endif %},
         "rollingAdvancement": {{ s.rolling_advancement | default: "week" | json | escape }},
         "weekOverflow": {{ s.week_overflow | default: "fewer_weeks" | json | escape }},
         "firstDay": {{ s.first_day | default: 1 | plus: 0 }},
         "hour12": {% if s.time_format == "am/pm" %}true{% else %}false{% endif %},
         "displayEventTime": {% if on_include_event_time %}true{% else %}false{% endif %},
         "displayEventEnd": {% if on_display_event_end %}true{% else %}false{% endif %},
         "weekNumbers": {% if on_show_week_numbers %}true{% else %}false{% endif %},
         "shadeWeekends": {% if on_shade_weekends %}true{% else %}false{% endif %},
         "locale": {{ locale | json | escape }}
       }'></div>
</div>
{% if on_month_header %}
  <div class="title_bar">
    <img class="image image--adaptive" alt="" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='black' stroke-width='2'%3E%3Crect x='3' y='5' width='18' height='16' rx='2'/%3E%3Cpath d='M3 10h18M8 3v4M16 3v4'/%3E%3C/svg%3E">
    <span class="title">{{ trmnl.plugin_settings.instance_name | default: "Calendar" | escape }}</span>
    <span class="instance" data-calendar-range></span>
  </div>
{% endif %}
{% endcapture %}
