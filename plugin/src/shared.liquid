{% comment %}
  Shared CSS + JS. Fork of usetrmnl/plugins lib/calendars/_common.html.erb, trimmed to
  what the month layouts use, plus the ICS / Home Assistant → FullCalendar event mapping.

  Upstream loads a private FullCalendar build from trmnl.com; the open-source build is
  enough for dayGrid. It loads from /rolling-month-calendar/..., which the LaraPaper (local) app
  in this repo serves so rendering needs no internet, and falls back to jsDelivr on
  any other server. The TRMNL.com variants set fullcalendar_from_cdn and load it from
  jsDelivr straight away. The stylesheets upstream links (plugins/calendars,
  plugins/calendars_full_month) aren't published, so the look below is a re-creation,
  written as a FullCalendar 7 theme ("Mono") plus the TRMNL framework's classes. Only
  FullCalendar's skeleton.css (layout, no looks) is loaded with it.
{% endcomment %}
{% assign cal_locale = trmnl.plugin_settings.custom_fields_values.locale | default: "en" | strip | downcase %}
{% assign fc_cdn = "https://cdn.jsdelivr.net/npm/fullcalendar@7.1.0" %}
{% if fullcalendar_from_cdn %}
{% comment %} The TRMNL.com variants (plugin/<variant>/fullcalendar.liquid): no local copy there {% endcomment %}
<link rel="stylesheet" href="{{ fc_cdn }}/skeleton.css">
<script src="{{ fc_cdn }}/all/global.js"></script>
{% if cal_locale != "en" and cal_locale != "" %}<script src="{{ fc_cdn }}/locales-all/global.js"></script>{% endif %}
{% else %}
<link rel="stylesheet" href="/rolling-month-calendar/fullcalendar/7.1.0/skeleton.css">
<script src="/rolling-month-calendar/fullcalendar/7.1.0/all/global.js"></script>
<script>window.FullCalendar || document.write('<link rel="stylesheet" href="{{ fc_cdn }}/skeleton.css"><script src="{{ fc_cdn }}/all/global.js"><\/script>');</script>
{% if cal_locale != "en" and cal_locale != "" %}
<script src="/rolling-month-calendar/fullcalendar/7.1.0/locales-all/global.js"></script>
<script>(window.FullCalendar && FullCalendar.globalLocales && FullCalendar.globalLocales.length) || document.write('<script src="{{ fc_cdn }}/locales-all/global.js"><\/script>');</script>
{% endif %}
{% endif %}

<style>
  /* ---------------------------------------------------------------------------------------
     "Mono": a monochrome FullCalendar 7 theme for the day grid, made for e-paper. It only
     needs FullCalendar's skeleton.css: the theme (window.trmnlMonoTheme below) puts these
     mono-* classes on the grid through FullCalendar's class hooks, and everything it paints
     comes from the --mono-* variables.
     --------------------------------------------------------------------------------------- */
  .mono {
    --mono-u: 1;                       /* size unit: everything scales with it */
    --mono-ink: #000;
    --mono-paper: #fff;
    --mono-line: #888;                 /* grid lines */
    --mono-line-style: solid;
    --mono-muted: #555;                /* past days, event times */
    --mono-weekend: #eee;              /* weekend cells and header */
    --mono-bar: #888;                  /* the bar left of timed events */
    --mono-fill: #ccc;                 /* events drawn as a band */
    --mono-fill-text: var(--mono-ink);
    --mono-line-width: 1px;
    color: var(--mono-ink);
  }

  /* grid: lines between cells only; FullCalendar's skeleton removes the outer ones */
  .mono-header, .mono-day { border-width: var(--mono-line-width); border-style: var(--mono-line-style); }
  .mono-header-divider, .mono-week { border-bottom-width: var(--mono-line-width); border-bottom-style: var(--mono-line-style); }
  .mono-week:last-child { border-bottom-width: 0; }

  /* weekday header: short, bold, uppercase; mono-header--today inverts a column's */
  .mono-header-inner {
    padding: calc(2px * var(--mono-u)) calc(6px * var(--mono-u));
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  /* narrow views: a one-week grid's headers carry the date too ("28 MON"), which didn't fit
     a quadrant's columns at TRMNL.com's regular scale */
  .trmnl-calendar--narrow .mono-header-inner { padding-inline: calc(2px * var(--mono-u)); letter-spacing: 0; }

  /* day number, right aligned, with the month's short name left of it where one starts
     (and on the grid's first day); today's number in a pill */
  .mono-day-top { display: flex; justify-content: flex-end; }
  .mono-day-label {
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    min-width: 0;
    padding: calc(3px * var(--mono-u)) calc(4px * var(--mono-u)) calc(1px * var(--mono-u));
  }
  .mono-day-top--narrow .mono-day-label { padding-left: calc(2px * var(--mono-u)); padding-right: calc(2px * var(--mono-u)); }
  .mono-month {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    padding-right: 0.4em;
  }
  .mono-day-number { min-width: 1.5em; padding: 0 0.3em; border-radius: 999px; text-align: center; }
  .mono-day-top--narrow .mono-month { padding-right: 0.15em; }
  .mono-month--no-room { display: none; }
  .mono-day-top--narrow .mono-day-number { min-width: 0; padding: 0 0.15em; }
  .mono-day-top--new-month .mono-day-number { font-weight: 700; }
  .mono-day--today .mono-day-number { min-width: 1.5em; font-weight: 700; }
  .mono-day-events { margin-bottom: calc(3px * var(--mono-u)); }

  /* week number, top left of the week's first cell */
  .mono-week-number { position: absolute; top: 0; left: 0; z-index: 1; font-weight: 700; padding: calc(3px * var(--mono-u)) calc(4px * var(--mono-u)) 0; }

  /* events: the title (up to two lines, then an ellipsis) above the time */
  .mono-event { margin-bottom: calc(2px * var(--mono-u)); line-height: 1.25; }
  .mono-event-inner { display: flex; flex-direction: column; min-width: 0; }
  .mono-event-title {
    order: -1;
    font-weight: 700;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }
  .mono-event--narrow .mono-event-title { -webkit-line-clamp: 3; overflow-wrap: break-word; }
  .mono-event-time { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* a multi-day timed event: start time, title and end time on one line (see eventContent) */
  .mono-event-row { display: flex; align-items: baseline; gap: 0.4em; min-width: 0; }
  .mono-event-row > .mono-event-title { order: 0; flex: 0 1 auto; min-width: 0; }
  .mono-event-row > .mono-event-time { flex: none; }
  .mono-event-time--end { margin-left: auto; padding-left: 0.4em; }

  /* timed (list-item) events: a bar on the left, the time below in grey */
  .mono-event--bar { align-items: stretch; gap: calc(4px * var(--mono-u)); margin-inline: calc(3px * var(--mono-u)); }
  .mono-event--bar.mono-event--narrow { gap: calc(2px * var(--mono-u)); margin-inline: calc(1px * var(--mono-u)) 0; }
  .mono-event-bar { flex: none; width: calc(3px * var(--mono-u)); border-radius: calc(2px * var(--mono-u)); }
  .mono-event--narrow .mono-event-bar { width: calc(2px * var(--mono-u)); }

  /* band (row) events: multi-day, or any with a colour of its own (FullCalendar's
     --fc-event-color, defaulting to --mono-fill). Where one continues from the previous
     week or into the next (or past the grid's edge), that end is pointed. */
  .mono-event--fill {
    --mono-cut-start: var(--mono-arrow);
    --mono-cut-end: var(--mono-arrow);
    --mono-arrow: calc(6px * var(--mono-u));
    overflow: hidden;
    clip-path: polygon(var(--mono-cut-start) 0, calc(100% - var(--mono-cut-end)) 0, 100% 50%,
      calc(100% - var(--mono-cut-end)) 100%, var(--mono-cut-start) 100%, 0 50%);
  }
  .mono-event--fill.mono-event--narrow { --mono-arrow: calc(3px * var(--mono-u)); }
  .mono-event--fill.mono-event--start { --mono-cut-start: 0px; }
  .mono-event--fill.mono-event--end { --mono-cut-end: 0px; }
  .mono-event--start { border-start-start-radius: calc(2px * var(--mono-u)); border-end-start-radius: calc(2px * var(--mono-u)); margin-inline-start: calc(3px * var(--mono-u)); }
  .mono-event--end { border-start-end-radius: calc(2px * var(--mono-u)); border-end-end-radius: calc(2px * var(--mono-u)); margin-inline-end: calc(3px * var(--mono-u)); }
  .mono-event--narrow.mono-event--start { margin-inline-start: calc(1px * var(--mono-u)); }
  .mono-event--narrow.mono-event--end { margin-inline-end: calc(1px * var(--mono-u)); }
  /* the text colour on the inner part, which a host's classes on the event don't reach */
  .mono-event--fill .mono-event-inner { color: var(--fc-event-contrast-color); }
  .mono-event--fill .mono-event-inner {
    flex: 1 1 auto;
    padding: calc(1px * var(--mono-u)) calc(4px * var(--mono-u) + var(--mono-cut-end)) calc(1px * var(--mono-u)) calc(4px * var(--mono-u) + var(--mono-cut-start));
  }
  .mono-event--fill.mono-event--narrow .mono-event-inner {
    padding: calc(1px * var(--mono-u)) calc(2px * var(--mono-u) + var(--mono-cut-end)) calc(1px * var(--mono-u)) calc(2px * var(--mono-u) + var(--mono-cut-start));
  }

  /* "+N more" */
  .mono-more { font-weight: 700; margin-inline-start: calc(3px * var(--mono-u)); }

  /* The theme's colours, in a cascade layer so that classes a host adds through the hooks
     win over them. Elsewhere this would be `@layer mono`; here it goes inside the TRMNL
     framework's base layer, below the framework's utilities (bg--*, text--*). */
  @layer tn--base.mono {
    .mono-header, .mono-day, .mono-header-divider, .mono-week { border-color: var(--mono-line); }
    .mono-weekend { background-color: var(--mono-weekend); }
    .mono-header--today { background-color: var(--mono-ink); color: var(--mono-paper); }
    .mono-day--past .mono-day-label { color: var(--mono-muted); }
    .mono-day--today .mono-day-number { background-color: var(--mono-ink); color: var(--mono-paper); }
    .mono-event-bar { background-color: var(--mono-bar); }
    .mono-event--bar .mono-event-time { color: var(--mono-muted); }
    .mono-event--fill { background-color: var(--fc-event-color); }
  }

  /* ---------------------------------------------------------------------------------------
     TRMNL adapter: the theme's variables from the framework's colours and --ui-scale; fonts,
     text sizes and the greys of each bit depth come from framework classes the JS adds
     through the same hooks (text--small, bg--gray-*, text--muted).
     --------------------------------------------------------------------------------------- */
  /* Framework 3.3.1: without bleed the full view's layout is the whole screen high even
     with a title bar after it (its rule outranks the one that leaves room), so the bar and
     the weeks above it end up off screen. Leave the room. */
  .screen--no-bleed .view--full .layout:has(+ .title_bar) {
    height: calc(var(--screen-h) - var(--gap) - var(--title-bar-height));
  }
  .trmnl-calendar {
    flex: 1 1 auto;
    align-self: stretch;
    min-height: 0;
    width: 100%;
  }
  .trmnl-calendar.mono {
    --mono-u: var(--ui-scale, 1);
    /* ink and paper are the framework's text and canvas colours, which dark mode (and a
       theme) swap; the raw palette (--black, --white) stays as it is */
    --mono-ink: var(--framework-text-primary, var(--black));
    --mono-paper: var(--framework-canvas-bg, var(--white));
    --mono-line: var(--gray-50);
    --mono-muted: var(--framework-text-secondary, var(--gray-30));
    --mono-weekend: transparent;      /* bg--gray-75 on the cells, see shadeClass */
    --mono-bar: transparent;          /* bg--gray-50, see listItemEventBeforeClass */
    --mono-fill: transparent;         /* bg--* on the event, see paintEvent */
  }
  /* 1-/2-bit can't print grey lines (dotted black instead) or grey text (solid black) */
  .screen--1bit .trmnl-calendar.mono,
  .screen--2bit .trmnl-calendar.mono { --mono-line: var(--mono-ink); --mono-line-style: dotted; --mono-muted: var(--mono-ink); }
  /* "Highlight today" off: no pill */
  .trmnl-calendar:not(.highlight-today) .mono-day--today .mono-day-number { background: none; color: inherit; font-weight: inherit; }

  /* "Fade past events": events that are over recede. Only where greys print as greys (4-bit);
     a 1-/2-bit pattern would make them unreadable instead.
     invert/brightness/invert mixes every pixel 40% towards white, like 60% opacity on a
     white cell; TRMNL's publish check rejects the opacity property. */
  .screen--4bit .trmnl-calendar.fade-past .mono-event--past { filter: invert(1) brightness(0.6) invert(1); }
  /* in dark mode, 40% towards black */
  .screen--4bit.screen--dark-mode .trmnl-calendar.fade-past .mono-event--past { filter: brightness(0.6); }

  /* a white calendar colour has no edge on a white cell: outline it like the grid lines,
     open (not pointed, which would cut the outline) where it continues in another week */
  .trmnl-calendar .trmnl-event--white { clip-path: none; --mono-cut-start: 0px; --mono-cut-end: 0px; border: 1px solid var(--mono-line); }
  .screen--1bit .trmnl-calendar .trmnl-event--white,
  .screen--2bit .trmnl-calendar .trmnl-event--white { border: 1px dotted var(--mono-ink); }
  .trmnl-calendar .trmnl-event--white:not(.mono-event--start) { border-inline-start-style: none; }
  .trmnl-calendar .trmnl-event--white:not(.mono-event--end) { border-inline-end-style: none; }

  /* patterned weekend cells make small text hard to read: back it with the paper colour */
  .screen--1bit .trmnl-calendar .mono-day-number,
  .screen--2bit .trmnl-calendar .mono-day-number,
  .screen--1bit .trmnl-calendar .mono-month,
  .screen--2bit .trmnl-calendar .mono-month,
  .screen--1bit .trmnl-calendar .mono-event--bar,
  .screen--2bit .trmnl-calendar .mono-event--bar { background-color: var(--mono-paper); }
  .screen--1bit .trmnl-calendar.highlight-today .mono-day--today .mono-day-number,
  .screen--2bit .trmnl-calendar.highlight-today .mono-day--today .mono-day-number { background-color: var(--mono-ink); }

  /* weather (weather_entity): icon and high at the left of the day's number line, after
     the week number where that sits. It wraps onto a hidden second line where the line
     runs out of room, so the low goes first, then the high, then the icon, and the month
     name and number never move */
  .trmnl-calendar .mono-day-label:has(.trmnl-weather) { flex: 1 1 auto; align-items: center; }
  .trmnl-calendar .mono-day-label:has(.trmnl-weather) :is(.mono-month, .mono-day-number) { flex: none; }
  .trmnl-calendar .trmnl-weather {
    display: inline-flex; flex: 0 1 auto; flex-wrap: wrap; align-items: center; align-content: flex-start;
    min-width: 0; height: 1.25em; overflow: hidden; column-gap: calc(3px * var(--mono-u));
    margin-right: auto; padding-right: 0.25em; color: var(--mono-ink); white-space: nowrap;
  }
  .trmnl-calendar .trmnl-weather--after-week { padding-left: 3em; }
  .trmnl-calendar .trmnl-weather-icon { width: 1.25em; height: 1.25em; flex: none; }
  .trmnl-calendar .trmnl-weather-high { font-weight: 700; }
  /* the low smaller, so it fits more often; not on 1-/2-bit, whose pixel fonts don't scale */
  .screen--4bit .trmnl-calendar .trmnl-weather-low { font-size: 0.8em; margin-left: calc(-1px * var(--mono-u)); }

  .trmnl-calendar-error { font-weight: 700; }
</style>

<script>
  // "Mono" theme for FullCalendar 7 (CSS above): a plugin of class hooks that name the day
  // grid's parts with mono-* classes, plus the day cell's content. A host adds its own
  // classes through the same hooks; FullCalendar joins both.
  window.trmnlMonoTheme = (function() {
    function join() { return Array.prototype.filter.call(arguments, Boolean).join(' '); }
    function isWeekend(info) { return info.dow === 0 || info.dow === 6; }
    function escapeHtml(text) {
      return String(text).replace(/[&<>"]/g, function(c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; });
    }
    // A timed event over several days is a band like an all-day one, on one line: the
    // start time at its left end, the end time at its right end, each under the day it
    // falls on. Over several weeks, the first week's band has the start time and the
    // last week's the end time; the pointed ends show where it goes on. Narrow bands
    // keep the time below the title, as only the start time fits there.
    function isMultiDay(event) {
      if (event.allDay || !event.end) return false;
      return event.start.toISOString().slice(0, 10) !== new Date(event.end.valueOf() - 1).toISOString().slice(0, 10);
    }
    // Bands on top: on the day an event starts, all-day events and timed events over
    // several days (see isMultiDay) come before that day's other timed events, which
    // FullCalendar's default order mixes them with by start time. It compares objects
    // with start/end in ms (wall-clock time as UTC here).
    function bandsFirst(a, b) {
      var day = function(ms) { return Math.floor(ms / 864e5); };
      var band = function(o) { return o.allDay || (o.end > o.start && day(o.end - 1) !== day(o.start)) ? 0 : 1; };
      return day(a.start) - day(b.start) || band(a) - band(b);
    }
    function eventContent(info) {
      var calendar = info.view.calendar;
      if (!isMultiDay(info.event) || info.isNarrow || calendar.getOption('displayEventTime') === false) return true;
      // the format as given (the view's own option is already compiled), else dayGrid's default
      var fmt = calendar.getOption('eventTimeFormat') || { hour: 'numeric', minute: '2-digit', omitZeroMinute: true, meridiem: 'narrow' };
      var start = info.isStart ? calendar.formatDate(info.event.start, fmt) : '';
      var end = info.isEnd && calendar.getOption('displayEventEnd') !== false ? calendar.formatDate(info.event.end, fmt) : '';
      function time(text, extra) {
        return text ? '<span class="' + escapeHtml(join(info.timeClass, extra)) + '">' + escapeHtml(text) + '</span>' : '';
      }
      return {
        html: '<div class="mono-event-row">' + time(start) +
          '<div class="' + escapeHtml(info.titleClass) + '">' + (info.event.title ? escapeHtml(info.event.title) : '&nbsp;') + '</div>' +
          time(end, 'mono-event-time--end') + '</div>'
      };
    }
    var dayRow = {
      listItemEventClass: 'mono-event mono-event--bar',
      listItemEventBeforeClass: 'mono-event-bar',
      listItemEventInnerClass: 'mono-event-inner',
      rowEventClass: function(info) {
        return join('mono-event mono-event--fill', info.isStart && 'mono-event--start', info.isEnd && 'mono-event--end');
      },
      rowEventInnerClass: 'mono-event-inner',
      rowMoreLinkClass: 'mono-more'
    };
    return {
      name: 'trmnl-mono',
      optionDefaults: {
        className: 'mono',
        eventColor: 'var(--mono-fill)',
        eventContrastColor: 'var(--mono-fill-text)',
        eventClass: function(info) { return join(info.isPast && 'mono-event--past', info.isNarrow && 'mono-event--narrow'); },
        eventContent: eventContent,
        // FullCalendar's default ('start,-duration,allDay,title') with bandsFirst in front
        eventOrder: [bandsFirst, 'start', '-duration', 'allDay', 'title'],
        eventTimeClass: 'mono-event-time',
        eventTitleClass: 'mono-event-title',
        dayHeaderRowClass: 'mono-header-row',
        dayHeaderDividerClass: 'mono-header-divider',
        dayHeaderClass: function(info) { return join('mono-header', isWeekend(info) && 'mono-weekend'); },
        dayHeaderInnerClass: 'mono-header-inner',
        dayHeaderAlign: 'center',
        dayRowClass: 'mono-week',
        dayCellClass: function(info) {
          return join('mono-day', isWeekend(info) && 'mono-weekend', info.isToday && 'mono-day--today', info.isPast && 'mono-day--past', info.isOther && 'mono-day--other');
        },
        dayCellTopClass: function(info) {
          return join('mono-day-top', info.isNarrow && 'mono-day-top--narrow', info.monthText && info.date.getUTCDate() === 1 && 'mono-day-top--new-month');
        },
        dayCellTopInnerClass: 'mono-day-label',
        // FullCalendar names the month where one starts (and on the grid's first day) in
        // monthStartFormat; short, as it sits next to the number. Some locales end it in a dot.
        monthStartFormat: { month: 'short', day: 'numeric' },
        dayCellTopContent: function(info) {
          var month = (info.monthText || '').replace(/\.$/, '');
          return {
            html: (month ? '<span class="mono-month">' + escapeHtml(month) + '</span>' : '') +
              '<span class="mono-day-number">' + escapeHtml(info.dayNumberText || info.date.getUTCDate()) + '</span>'
          };
        },
        dayCellInnerClass: 'mono-day-events',
        inlineWeekNumberClass: 'mono-week-number'
      },
      views: { dayGrid: dayRow }
    };
  })();
  // Home Assistant REST (/api/calendars/<entity>) and server-parsed ICS feeds →
  // FullCalendar events.
  // Stands in for the closed-source Calendar::Helper of the native plugin and mirrors
  // the filtering of Plugins::GoogleCalendar#prepare_events.
  window.trmnlRollingCalendar = (function() {
    function splitList(value) {
      return String(value || '').split(',').map(function(v) { return v.trim(); }).filter(Boolean);
    }

    // Per-calendar lists (prefixes, colours) line up with the calendar entities by
    // position; "-" leaves a calendar without a value.
    function splitAligned(value) {
      return splitList(value).map(function(v) { return v === '-' ? '' : v; });
    }

    // A calendar colour is a framework palette token (black, white, gray-10..gray-75,
    // red, blue-40, ...), painted with its bg--* class so every screen gets its own
    // rendering (solid grey on 4-bit, dither pattern on 1-/2-bit, ink on colour panels),
    // or a hex colour, painted as-is.
    var HUES = 'red|orange|yellow|lime|green|cyan|blue|violet|purple|pink';
    var TOKEN = new RegExp('^(black|white|gray-(10|15|20|25|30|35|40|45|50|55|60|65|70|75)|(' + HUES + ')(-(10|15|20|25|30|35|40|45|50|55|60|65|70|75))?)$');
    var HEX = /^#([0-9a-f]{3}|[0-9a-f]{6})$/i;
    function parseColor(value) {
      var v = String(value || '').trim().toLowerCase().replace(/^bg--/, '');
      if (TOKEN.test(v)) return { token: v };
      if (HEX.test(v)) return { hex: v };
      return null;
    }

    // LaraPaper parses an ICS feed into { ical: [{ SUMMARY, DTSTART, DTEND, ... }] }, with
    // recurring events expanded, events from 7 days back to 30 days ahead, and every date
    // as an ISO string with an offset. The all-day flag doesn't survive: all-day events
    // are the ones running midnight to midnight, and their dates are read as written.
    // Turned into HA's shape here, so the rest treats both sources alike.
    var DATE_ONLY = /^\d{4}-\d{2}-\d{2}$/;
    var MIDNIGHT = /^\d{4}-\d{2}-\d{2}T00:00(:00(\.0+)?)?(Z|[+-]\d{2}:?\d{2})?$/;
    function fromIcal(ev) {
      if (!ev || typeof ev !== 'object' || !ev.DTSTART) return null;
      if (String(ev.STATUS || '').toUpperCase() === 'CANCELLED') return null;
      var start = String(ev.DTSTART), end = ev.DTEND ? String(ev.DTEND) : null;
