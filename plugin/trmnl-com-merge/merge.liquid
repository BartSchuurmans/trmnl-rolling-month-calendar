{% assign merge_values = trmnl.plugin_settings.custom_fields_values %}
{% assign merge_sources = false %}
{% assign merge_weather = false %}
{% comment %} Field names spelled out: TRMNL's publish check flags fields it can't find in the markup.
   The weather plugin goes last, after the calendars (buildEvents in shared.liquid). {% endcomment %}
{% assign merge_fields = "calendar_1,calendar_2,calendar_3,calendar_4,calendar_5,calendar_6,calendar_7,calendar_8" | split: "," %}
{% assign merge_weather_key = merge_values.weather_plugin | default: "" | strip %}
{% capture merge_json %}{
{%- for merge_field in merge_fields -%}
  {%- assign merge_key = merge_values[merge_field] | default: "" | strip -%}
  {%- unless forloop.first %}, {% endunless -%}
  "IDX_{{ forloop.index0 }}": {% if merge_key != "" %}{% assign merge_sources = true %}{{ [merge_key] | json | default: "null" }}{% else %}null{% endif %}
{%- endfor -%}
{%- if merge_weather_key != "" -%}
  {%- assign merge_sources = true -%}{%- assign merge_weather = true -%}
  , "IDX_{{ merge_fields.size }}": {{ [merge_weather_key] | json | default: "null" }}
{%- endif -%}
}{% endcapture %}
