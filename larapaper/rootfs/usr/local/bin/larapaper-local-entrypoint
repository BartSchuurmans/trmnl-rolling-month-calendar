#!/bin/sh
# Runs before the add-on's own entrypoint (homeassistant-entrypoint), which takes the
# Supervisor token out of the environment so LaraPaper and its recipes never see it.
# The device sensors still need it once, to ask the Supervisor for the MQTT broker's
# address and login: this keeps a root-only copy for the sensors' run script, which
# asks as root and passes only the broker's details on to mqtt.php (as www-data).
set -e
token="${SUPERVISOR_TOKEN:-${HASSIO_TOKEN:-}}"
if [ -n "$token" ]; then
    (umask 077 && mkdir -p /etc/larapaper-local && printf '%s' "$token" > /etc/larapaper-local/supervisor_token)
fi
unset token
exec /usr/local/bin/homeassistant-entrypoint "$@"
